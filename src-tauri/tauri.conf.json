{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Team Principal",
  "version": "0.1.0",
  "identifier": "com.teamprincipal.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Team Principal",
        "width": 1440,
        "height": 940,
        "minWidth": 1024,
        "minHeight": 700,
        "resizable": true,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"],
    "copyright": "Alex Camenzuli",
    "shortDescription": "Sim racing launcher and display manager",
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "languages": ["English"]
      }
    }
  }
}
