# Generated IPC bindings ARE committed — CI regenerates them and fails on a
# diff, which is what makes a stale contract impossible to merge.

# Local
.env
.env.local
*.log
.DS_Store

# The updater signing key. The public half lives in src-tauri/tauri.conf.json
# and is committed on purpose; this is the private half, and a copy of it in
# the repository would let anyone sign an update that every install accepts.
.updater-key/
